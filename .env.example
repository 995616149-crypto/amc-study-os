# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you need. Everything here is optional: with no
# `.env` at all the app runs fully locally on its bundled D1 database.
# ---------------------------------------------------------------------------

# --- AI features (question coach, tutor, translation, word lookup) ----------
# Any OpenAI-compatible endpoint works: DeepSeek, Moonshot, Qwen, OpenRouter,
# a local vLLM/Ollama gateway, etc. Without a key the AI surfaces return a
# "not configured" error; the rest of the app is unaffected.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Optional: durable learner-state mirror ---------------------------------
# Set this only if you run the SQL in cloud/0063_state_store.sql against a
# Postgres instance and want learner state copied there. Leave empty otherwise:
# state is then written straight to the local D1 database.
STATE_SECRET=

# --- Optional: hosted cloud backend -----------------------------------------
# Only needed for the hosted variant (cloud state mirroring, keyless model
# calls, hosted sign-in). Leave empty for self-hosting.
CLOUD_RELEASE_ORIGIN=
CLOUD_ENDPOINT=
CLOUD_PUBLISHABLE_KEY=
CLOUD_RESOURCE_ID=
CLOUD_APP_ID=
CLOUD_OAUTH_RELAY_BASE_URL=

# --- Optional: textbook corpus location -------------------------------------
# Absolute path to the parsed textbook tree, if you keep it outside the repo.
TEXTBOOK_MURTAGH_ROOT=
